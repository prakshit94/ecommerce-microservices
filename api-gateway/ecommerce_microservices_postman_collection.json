{
  "info": {
    "name": "Ecommerce Microservices APIs - Full",
    "_postman_id": "12345678-1234-1234-1234-123456789012",
    "description": "Complete Postman collection for Auth, Users, Roles, Permissions with Granular RBAC and Enriched Responses",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Sample Personas (Login)",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "response": [
            {
              "name": "Admin Login Response",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"message\": \"Login successful\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Super Admin\",\n    \"email\": \"admin@example.com\"\n  },\n  \"token\": \"eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...\",\n  \"token_type\": \"bearer\",\n  \"expires_in\": 3600\n}"
            }
          ]
        },
        {
          "name": "Login as Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login as Editor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"editor@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login as Viewer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"viewer@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Auth Root",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/auth/register"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/auth/change-password"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password123\",\n  \"new_password\": \"newpassword\",\n  \"new_password_confirmation\": \"newpassword\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/users"
            }
          },
          "response": [
            {
              "name": "User List Enriched",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": 1,\n    \"name\": \"Super Admin\",\n    \"email\": \"admin@example.com\",\n    \"roles\": [\n      {\n        \"id\": 1,\n        \"name\": \"Admin\",\n        \"permissions\": [\n          { \"id\": 1, \"name\": \"user-list\" }\n        ]\n      }\n    ],\n    \"permissions\": []\n  }\n]"
            }
          ]
        },
        {
          "name": "Get User Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/users/1"
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/users/1"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Admin\"\n}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/users/5"
            }
          },
          "response": [
            {
              "name": "User Deletion Enriched",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"message\": \"User deleted successfully\",\n  \"id\": 5\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "List Roles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/roles"
            }
          }
        },
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/roles"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Moderator\"\n}"
            }
          }
        },
        {
          "name": "Assign Permissions to Role",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/roles/1/permissions"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\"user-list\", \"user-view\"]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Permissions",
      "item": [
        {
          "name": "List Permissions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/permissions"
            }
          }
        }
      ]
    },
    {
      "name": "User Assignments (RBAC)",
      "item": [
        {
          "name": "Get User Roles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/users/1/roles"
            }
          },
          "response": [
            {
              "name": "User Roles Details",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": 1,\n    \"name\": \"Admin\",\n    \"guard_name\": \"web\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Get User Direct Permissions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/users/1/permissions"
            }
          }
        }
      ]
    }
  ]
}