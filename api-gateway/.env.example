# 🌐 API Gateway — Enterprise Configuration

APP_NAME="API Gateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# 📝 Logging
LOG_CHANNEL=stack
LOG_LEVEL=warning

# 🗄️ Database (Gateway uses minimal DB — mainly sessions + cache tables)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_gateway
DB_USERNAME=root
DB_PASSWORD=

# ⚙️ Driver Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# 🚀 Redis — Required for: JWT validation caching, rate limiting, session caching
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=3

# 🔗 Downstream Services
AUTH_SERVICE_URL=http://127.0.0.1:8001/api
USER_SERVICE_URL=http://127.0.0.1:8002/api

# 🔐 Security (MUST match across all services)
JWT_SECRET=CHANGE_ME_USE_php_artisan_jwt_secret
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
GATEWAY_SECRET=CHANGE_ME_STRONG_RANDOM_64_CHARS

# 🌐 CORS Allowed Origins (comma separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Device-Fingerprint,X-App-Version
CORS_EXPOSE_HEADERS=X-Request-Id,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset
CORS_MAX_AGE=86400
CORS_SUPPORTS_CREDENTIALS=true

# 🔒 Rate Limiting
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTHENTICATED=1000