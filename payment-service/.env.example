# 🧬 Ecommerce Ecosystem: PaymentService Configuration

APP_NAME=PaymentService
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# 📝 Logging & Monitoring
LOG_CHANNEL=stack
LOG_LEVEL=info

# 🗄️ Database Configuration (Production-Ready MySQL)
# Ensure the database 'ecommerce_payment' is created before running migrations.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_payment
DB_USERNAME=root
DB_PASSWORD=

# ⚙️ Driver Configurations
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# 🔐 Security Hardening (STRICT)
# 🚨 These secrets MUST match across ALL microservices for the ecosystem to function.
JWT_SECRET=lXYyK9LM99MEEbm5gy83Ii8vroefo03okr78iUp3juRStoTDO65FWblN2kLoaWR7
GATEWAY_SECRET=SomeRandomStrongSecret123

# 🧪 Development & Testing
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
