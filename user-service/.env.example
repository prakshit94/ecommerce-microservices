# 👥 User Service — Enterprise Configuration

APP_NAME="User Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8002

# 📝 Logging
LOG_CHANNEL=stack
LOG_LEVEL=warning

# 🗄️ Database (MySQL for production, SQLite for dev)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_users
DB_USERNAME=root
DB_PASSWORD=

# ⚙️ Driver Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# 🚀 Redis — Required for: permission caching, rate limiting
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=2

# 🔐 Security (MUST match across all services)
GATEWAY_SECRET=CHANGE_ME_STRONG_RANDOM_64_CHARS

# 🔒 Spatie Permission Cache
PERMISSION_CACHE_EXPIRATION_SECONDS=3600
