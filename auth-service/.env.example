# 🔐 Auth Service — Enterprise Configuration

APP_NAME="Auth Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001

# 📝 Logging
LOG_CHANNEL=stack
LOG_LEVEL=warning

# 🗄️ Database (MySQL for production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_auth
DB_USERNAME=root
DB_PASSWORD=

# ⚙️ Driver Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# 🚀 Redis — Required for: session caching, JWT claim caching, rate limiting
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# 🔗 Microservice Routing
USER_SERVICE_URL=http://127.0.0.1:8002/api

# 🔐 Security (MUST match across all services)
JWT_SECRET=CHANGE_ME_USE_php_artisan_jwt_secret
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
GATEWAY_SECRET=CHANGE_ME_STRONG_RANDOM_64_CHARS

# 📧 Mail (for password reset, email verification)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@yourapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# 🔒 Auth Security Policy
MFA_ENABLED=true
SESSION_LOCK_FAILED_ATTEMPTS=5
SESSION_LOCK_DURATION_MINUTES=15

# 🌐 CORS (handled at gateway level)
FRONTEND_URL=http://localhost:3000
