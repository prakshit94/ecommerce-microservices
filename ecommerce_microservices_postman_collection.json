		{
			"name": "3. Security & Sessions",
			"item": [
				{
					"name": "Get Active Sessions",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(pm.response.code === 200 && jsonData.sessions && jsonData.sessions.length > 0) {",
									"    // Grab a non-current session to test revocation",
									"    var otherSession = jsonData.sessions.find(s => !s.is_current);",
									"    if (otherSession) pm.collectionVariables.set(\"session_id\", otherSession.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
